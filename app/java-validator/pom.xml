<?xml version="1.0" encoding="UTF-8"?>
<!--
  OMA Java Validator - Maven 빌드 설정

  변환된 MyBatis 매퍼 SQL을 소스(Oracle)/타겟(PostgreSQL/MySQL) DB에서 실행해
  결과를 비교 검증한다. MyBatis SqlSessionFactory의 getBoundSql로 동적 SQL을
  완벽하게 완성한 뒤 실행하므로 XML 파싱/정규식이 불필요하다.

  빌드: mvn -f java-validator/pom.xml clean package
  산출물: target/oma-validator.jar (fat jar, java -jar 로 실행)

  변경 이력:
  2026-07-27 | OMA Team | 초기 생성
    - MyBatis 3.5.13, ojdbc11, postgresql, mysql-connector, gson
    - shade 플러그인으로 의존성 포함 실행 가능 jar 생성
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.oma</groupId>
    <artifactId>oma-validator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis.version>3.5.13</mybatis.version>
        <gson.version>2.10.1</gson.version>
    </properties>

    <dependencies>
        <!-- MyBatis: getBoundSql로 동적 SQL 완성 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>${mybatis.version}</version>
        </dependency>

        <!-- DB Drivers -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.4.0.24.05</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!-- JSON (Python 브리지 통신) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>oma-validator</finalName>
        <plugins>
            <!-- Java 17 컴파일 (구버전 기본 플러그인의 source 5 폴백 방지) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- 의존성 포함 실행 가능 jar (fat jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.oma.validator.ValidationService</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
